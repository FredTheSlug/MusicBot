<!-- author: Kaidan Gustave -->
<configuration>

    <appender name="Simple" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- Pattern -->
            <pattern>
                %nopex[%d{HH:mm:ss}] [%level] [%logger{0}]: %msg%n%ex
            </pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="Simple"/>
    </root>

    <logger name="dev.lavalink.youtube" level="INFO"/>
    <logger name="dev.lavalink.youtube.http.YoutubeOauth2Handler" level="INFO"/>
    <logger name="AudioHandler" level="INFO"/>

</configuration>
