{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mini-player",
  "description": "The bundled mini-player window: state events, dragging, and its own commands.",
  "windows": ["mini-player"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-mini-get-state",
    "allow-mini-command",
    "allow-mini-open-panel",
    "allow-mini-hide",
    "allow-mini-spotify-now",
    "allow-mini-send-spotify",
    "allow-mini-play-spotify-text",
    "allow-mini-search",
    "allow-mini-lyrics",
    "allow-mini-play-link",
    "allow-mini-get-prefs",
    "allow-mini-set-opacity",
    "allow-mini-set-theme",
    "allow-mini-set-panel"
  ]
}
