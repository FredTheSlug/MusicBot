{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mini-player",
  "description": "The bundled mini-player window: state events, dragging, and its own commands.",
  "windows": ["mini-player"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "allow-mini-get-state",
    "allow-mini-command",
    "allow-mini-open-panel",
    "allow-mini-show-whats-new",
    "allow-mini-hide",
    "allow-mini-spotify-now",
    "allow-mini-send-spotify",
    "allow-mini-play-spotify-text",
    "allow-mini-search",
    "allow-mini-lyrics",
    "allow-mini-play-link",
    "allow-mini-get-prefs",
    "allow-mini-set-opacity",
    "allow-mini-set-theme",
    "allow-mini-refresh-themes",
    "allow-mini-set-panel",
    "allow-mini-history",
    "allow-mini-frequent",
    "allow-mini-playlists",
    "allow-mini-playlists-v2",
    "allow-mini-add-to-playlist",
    "allow-mini-create-playlist",
    "allow-mini-play-playlist",
    "allow-mini-set-sleep",
    "allow-mini-get-sleep",
    "allow-mini-set-hide-in-fullscreen",
    "allow-mini-get-hotkeys",
    "allow-mini-set-hotkeys-enabled",
    "allow-mini-set-hotkey",
    "allow-mini-set-compact",
    "allow-mini-hotkeys-suspend"
  ]
}
