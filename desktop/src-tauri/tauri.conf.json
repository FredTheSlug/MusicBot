{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clout Kings Music Bot",
  "version": "0.5.0",
  "identifier": "com.fredtheslug.musicbot.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlDRkE1RjdFOThBQUE0QkIKUldTN3BLcVlmbC82bkFFZktZSW5ZcWVDbnR1L0prZmRRY0crVmhTay9vQkU4dkd1MzV6RkZmdlAK",
      "endpoints": [
        "https://github.com/FredTheSlug/MusicBot/releases/download/desktop-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
